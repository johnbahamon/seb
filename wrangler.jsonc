{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "groupe-seb",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",

  // The Angular build is served straight from the edge: asset requests are free
  // and unlimited, and never invoke the Worker. Only /api/* costs an invocation,
  // which is what keeps this inside the free plan.
  "assets": {
    "directory": "./dist/groupeseb/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* -> admin (lo cierra Access). /data/catalog.json y /img/* -> publicas,
    // las sirve el Worker desde R2 para que una edicion se vea al refrescar.
    // Todo lo demas sigue saliendo como asset estatico, gratis e ilimitado.
    "run_worker_first": ["/api/*", "/data/catalog.json", "/img/*"]
  },


  // Imagenes subidas desde /admin. R2 no cobra egress, que es lo que evita
  // un techo de ancho de banda al servir fotos de producto.
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "groupe-seb-images" }
  ],

  // La URL no es secreta. La service_role key va como secret:
  //   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  "vars": {
    "SUPABASE_URL": "https://brqavwhvfpvcyuxmshsm.supabase.co"
  },

  "observability": { "enabled": true }
}
