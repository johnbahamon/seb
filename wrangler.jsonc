{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "groupe-seb",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",

  // The Angular build is served straight from the edge: asset requests are free
  // and unlimited, and never invoke the Worker. Only /api/* costs an invocation,
  // which is what keeps this inside the free plan.
  "assets": {
    "directory": "./dist/groupeseb/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "groupe-seb-catalog",
      "database_id": "a8994de2-4d1c-494f-b30b-f2bcbf549627"
    }
  ],

  "observability": { "enabled": true }
}
